geStyle;rounded=1;html=1;strokeColor=#8A94A6;endArrow=block;endFill=1;" edge="1" parent="1" source="n15" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="n11" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;Chưa chuẩn hóa&lt;/b&gt;&lt;br&gt;Có nhóm lặp { } theo từng vé và thuộc tính đa trị {TheLoai}." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="190" height="130" as="geometry"/></mxCell><mxCell id="n41" value="&lt;b&gt;1NF&lt;/b&gt;&lt;br&gt;Tách thuộc tính đa trị ra bảng riêng, trải nhóm lặp mỗi vé một dòng. Mọi giá trị nguyên tố." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="190" height="130" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b&gt;2NF&lt;/b&gt;&lt;br&gt;Bỏ phụ thuộc bộ phận: tách theo MaDatVe, MaSuat, MaGhe." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="190" height="130" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;3NF / BCNF&lt;/b&gt;&lt;br&gt;Bỏ phụ thuộc bắc cầu qua MaKH, MaPhim, MaPhong, MaLoaiGhe; tách thanh toán. Thêm khóa thay thế MaVe, MaTL." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="190" height="130" as="geometry"/></mxCell><mxCell id="n44" value="Gạch chân đậm = khóa chính, nghiêng = khóa ngoại. TaiKhoan và NhanVien thêm vào cho chức năng đăng nhập (không xuất hiện trên phiếu). Nét đứt: PhongChieu nhận từ cả SUAT2 và GHE2." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="1220" width="1800" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>